<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.sliceworkz</groupId>
		<artifactId>sliceworkz-eventstore-parent-pom</artifactId>
		<version>0.12.0-SNAPSHOT</version>
		<relativePath>../sliceworkz-eventstore-parent-pom</relativePath>
	</parent>
	
	<name>${project.artifactId}</name>
	<description>DCB (Dynamic Consistency Boundary) compliant EventStore (Java/Postgres)</description>
	<url>https://sliceworkz.github.io/eventstore</url>

	<artifactId>sliceworkz-eventstore-api</artifactId>
	<packaging>jar</packaging>

	<properties>
		<!-- the name this jar has on the module path (see the parent pom) -->
		<automatic.module.name>org.sliceworkz.eventstore</automatic.module.name>
		<!-- client-facing: publish to the configured repository -->
		<maven.deploy.skip>false</maven.deploy.skip>
	</properties>
	
	<!-- SLF4J is the api's one dependency; Jackson and any metrics library are not - see "What the published artifacts put on a consumer's classpath" in CLAUDE.md -->
	<dependencies>
		<dependency>
		    <groupId>org.slf4j</groupId>
		    <artifactId>slf4j-api</artifactId>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>no-jackson-in-the-api</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<bannedDependencies>
									<message>The api artifact must not carry Jackson (see CLAUDE.md); declare it in the module that uses it.</message>
									<searchTransitive>true</searchTransitive>
									<excludes>
										<exclude>tools.jackson.*:*:*:*:compile</exclude>
										<exclude>tools.jackson.*:*:*:*:runtime</exclude>
										<exclude>com.fasterxml.jackson.*:*:*:*:compile</exclude>
										<exclude>com.fasterxml.jackson.*:*:*:*:runtime</exclude>
									</excludes>
									<includes>
										<include>com.fasterxml.jackson.core:jackson-annotations</include>
									</includes>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
