<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.sliceworkz</groupId>
		<artifactId>sliceworkz-eventstore-parent-pom</artifactId>
		<version>0.11.0-SNAPSHOT</version>
		<relativePath>../sliceworkz-eventstore-parent-pom</relativePath>
	</parent>

	<name>${project.artifactId}</name>
	<description>DCB (Dynamic Consistency Boundary) compliant EventStore (Java/Postgres) - Single-process append-only binary log</description>
	<url>https://sliceworkz.github.io/eventstore</url>

	<artifactId>sliceworkz-eventstore-infra-file</artifactId>
	<packaging>jar</packaging>

	<properties>
		<!-- client-facing: publish to the configured repository -->
		<maven.deploy.skip>false</maven.deploy.skip>
	</properties>

	<dependencies>
		<!--
			Deliberately no dependency on infra-inmem or infra-inmem-fs. This is a storage engine of
			its own, not a decorator over the in-memory store, and a dependency edge to one would say
			otherwise. The handful of semantics shared with the in-memory backend are reproduced here
			with the reasoning attached, which is what the TCK holds both of them to anyway.
		-->
		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-impl</artifactId>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

</project>
