<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.sliceworkz</groupId>
		<artifactId>sliceworkz-eventstore-parent-pom</artifactId>
		<version>0.10.2-SNAPSHOT</version>
		<relativePath>../sliceworkz-eventstore-parent-pom</relativePath>
	</parent>

	<name>${project.artifactId}</name>
	<description>DCB (Dynamic Consistency Boundary) compliant EventStore (Java/Postgres)</description>
	<url>https://sliceworkz.github.io/eventstore</url>

	<artifactId>sliceworkz-eventstore-tests</artifactId>
	<packaging>jar</packaging>

	<!--
		Runs the shared TCK scenarios (which live in sliceworkz-eventstore-testing, so third parties
		can run them too) against every backend this repository ships, plus the few tests that are
		repo-internal rather than part of the storage contract.

		The backends are registered in
		src/test/resources/META-INF/services/org.sliceworkz.eventstore.testing.EventStoreBackend —
		that file is the whole configuration. Narrow a local run with, for example,
		-Deventstore.testing.backends=inmem to skip the containers.
	-->
	<dependencies>
		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-impl</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-testing</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-infra-inmem</artifactId>
		</dependency>
		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-infra-inmem-fs</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.sliceworkz</groupId>
			<artifactId>sliceworkz-eventstore-infra-postgres</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
		    <groupId>org.awaitility</groupId>
		    <artifactId>awaitility</artifactId>
		</dependency>

		<!--
			The testing module declares these <optional>, so a consumer running the TCK against
			their own storage does not inherit Testcontainers. Running the Postgres backends here
			means declaring them explicitly.
		-->
		<dependency>
		    <groupId>org.postgresql</groupId>
		    <artifactId>postgresql</artifactId>
		    <scope>test</scope>
		</dependency>
		<dependency>
		    <groupId>org.testcontainers</groupId>
		    <artifactId>testcontainers-postgresql</artifactId>
		    <scope>test</scope>
		</dependency>
		<dependency>
		    <!-- needed for PostgresLegacyEventStorageImpl when the scenarios run against PostgreSQL 17 -->
		    <groupId>com.github.f4b6a3</groupId>
		    <artifactId>uuid-creator</artifactId>
		    <scope>test</scope>
		</dependency>
		<dependency>
		    <groupId>com.zaxxer</groupId>
		    <artifactId>HikariCP</artifactId>
		    <scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						The TCK scenarios are main classes of the testing module, not test classes of
						this one, so surefire has to be told to scan that artifact for them. This is
						the same one line a third-party EventStorage adds to run the suite.
					-->
					<dependenciesToScan>
						<dependency>org.sliceworkz:sliceworkz-eventstore-testing</dependency>
					</dependenciesToScan>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
